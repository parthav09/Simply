{
 "report_version": 1,
 "source": "evidence-dashboard.json default view",
 "view": "openrouter_v3",
 "thresholds": {
  "invalid_rate_review": 0.05,
  "invalid_rate_fail": 0.2,
  "no_progress_review": 30,
  "impulse_tiers": {
   "impulsive": {
    "cap": 2,
    "max_price_cents": 800
   },
   "mixed": {
    "cap": 1,
    "max_price_cents": 400
   },
   "planner": {
    "cap": 1,
    "max_price_cents": 250
   }
  }
 },
 "rules": [
  {
   "check": "checkout_incomplete",
   "severity": "fail",
   "label": "Shopper never finished checkout",
   "description": "The recording ends without a completed checkout for this shopper."
  },
  {
   "check": "provider_exception",
   "severity": "fail",
   "label": "Model provider error",
   "description": "At least one request failed at the provider (not a bad reply from the model)."
  },
  {
   "check": "allergen_conflict",
   "severity": "fail",
   "label": "Allergen in an unplanned purchase",
   "description": "A paid off-list product lists the shopper's declared allergen in the catalogue data."
  },
  {
   "check": "invalid_reply_rate_high",
   "severity": "fail",
   "label": "Most actions invalid or rejected",
   "description": "More than 20% of the shopper's actions were invalid replies or grid rejections."
  },
  {
   "check": "invalid_reply_rate",
   "severity": "review",
   "label": "Some actions invalid or rejected",
   "description": "More than 5% of the shopper's actions were invalid replies or grid rejections."
  },
  {
   "check": "impulse_cap",
   "severity": "review",
   "label": "More unplanned items than the impulse tier allows",
   "description": "Paid off-list units exceed impulse_eval.TIERS for the shopper's impulse probability (and any off-list item below probability 0.10). A teacher rule, not necessarily in the prompt."
  },
  {
   "check": "impulse_price",
   "severity": "review",
   "label": "Unplanned item above the tier price ceiling",
   "description": "A paid off-list product costs more than impulse_eval.TIERS allows for the tier."
  },
  {
   "check": "diet_or_alcohol_mismatch",
   "severity": "review",
   "label": "Unplanned item may not fit the shopper's diet",
   "description": "Catalogue tags do not show the item fits the diet or alcohol preference (unknown counts as not fitting). Tags are catalogue metadata and are not independently verified."
  },
  {
   "check": "over_budget",
   "severity": "review",
   "label": "Final basket above the shopper's budget",
   "description": "Budgets are soft preferences in Simply, so this is recorded for review, not rejected."
  },
  {
   "check": "above_acceptable_price",
   "severity": "review",
   "label": "Listed item bought above the acceptable price",
   "description": "A listed product was paid above the shopper's stated maximum acceptable unit price."
  },
  {
   "check": "list_incomplete",
   "severity": "review",
   "label": "Finished with part of the list unbought",
   "description": "Checkout finished but fewer listed units were paid than requested."
  },
  {
   "check": "loop_detected",
   "severity": "review",
   "label": "Repeated action loop",
   "description": "Python core's loop detector fired for this shopper."
  },
  {
   "check": "stuck",
   "severity": "review",
   "label": "No progress for 30+ turns",
   "description": "The cart and phase did not change for a long stretch of consecutive turns."
  }
 ],
