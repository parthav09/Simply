# Create .env at the repository root; keep existing credentials private.
# Default CLI/web transport: OpenRouter, pinned OpenAI endpoint, no fallbacks.
# OPEN_ROUTER_KEY is also accepted for existing local configuration.
OPENROUTER_API_KEY=

# Optional direct OpenAI transport: --provider openai.
OPENAI_API_KEY=

# Optional legacy provider; selected only with --provider gemini.
GEMINI_API_KEY=
